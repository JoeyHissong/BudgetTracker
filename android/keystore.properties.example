# Copy this file to keystore.properties (gitignored) and fill in real values.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore budgetplanner-release.keystore \
#     -alias budgetplanner-release -keyalg RSA -keysize 2048 -validity 10000
storeFile=budgetplanner-release.keystore
storePassword=changeme
keyAlias=budgetplanner-release
keyPassword=changeme
