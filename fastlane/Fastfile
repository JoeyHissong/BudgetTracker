default_platform(:android)

platform :android do
  desc "Upload the release AAB to the Google Play internal testing track"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: ENV["ANDROID_AAB_PATH"] || "../android/app/build/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end
end
